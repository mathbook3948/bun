@@ -48,11 +48,58 @@ WTF_MAKE_TZONE_ALLOCATED_IMPL(SignatureRegistry);
 
 CompileCounts g_ffiCompileCounts;
 
+#if USE(BUN_LIBFFI)
+static ffi_type* nativeType(Type type)
+{
+    switch (type) {
+    case Type::Char:
+    case Type::Int8: return &ffi_type_sint8;
+    case Type::Bool:
+    case Type::Uint8: return &ffi_type_uint8;
+    case Type::Int16: return &ffi_type_sint16;
+    case Type::Uint16: return &ffi_type_uint16;
+    case Type::Int32: return &ffi_type_sint32;
+    case Type::Uint32: return &ffi_type_uint32;
+    case Type::Int64:
+    case Type::Int64Fast: return &ffi_type_sint64;
+    case Type::Uint64:
+    case Type::Uint64Fast:
+    case Type::BufferLength:
+    case Type::JSValue: return &ffi_type_uint64;
+    case Type::Float: return &ffi_type_float;
+    case Type::Double: return &ffi_type_double;
+    case Type::Pointer:
+    case Type::CString:
+    case Type::Function:
+    case Type::Buffer: return &ffi_type_pointer;
+    case Type::Void: return &ffi_type_void;
+    case Type::RESERVED_WasNapiEnv: RELEASE_ASSERT_NOT_REACHED();
+    }
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+void Signature::invokeNative(void* target, uint64_t* slots)
+{
+#if !CPU(ARM64) || !CPU(LITTLE_ENDIAN)
+#error The libffi slot adapter requires little-endian ARM64.
+#endif
+    void* arguments[maxArguments];
+    for (unsigned i = 0; i < argumentCount(); ++i)
+        arguments[i] = &slots[i];
+    ffi_call(&m_nativeCIF, FFI_FN(target), &slots[argumentCount()], arguments);
+}
+#endif
+
 Signature::Signature(std::span<const Type> arguments, Type returnType)
     : m_arguments(arguments)
     , m_returnType(returnType)
 {
     m_hash = computeHash(arguments, returnType);
+#if USE(BUN_LIBFFI)
+    for (unsigned i = 0; i < argumentCount(); ++i)
+        m_nativeArguments[i] = nativeType(argumentType(i));
+    RELEASE_ASSERT(ffi_prep_cif(&m_nativeCIF, FFI_DEFAULT_ABI, argumentCount(), nativeType(returnType), m_nativeArguments) == FFI_OK);
+#endif
 }
 
